; Kernel audio driver for the Native Instruments Audio Kontrol 1.

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = ak1acx.cat
DriverVer   =
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
ak1acx.sys = 1,,

; Built for KMDF 1.33, which first shipped in Windows 11 21H2 (build 22000).
[Manufacturer]
%ProviderName% = Devices,NTamd64.10.0...22000

[Devices.NTamd64.10.0...22000]
%DeviceDesc% = Ak1_Device, USB\VID_17CC&PID_0815

[Ak1_Device.NT]
CopyFiles = Ak1_CopyFiles

[Ak1_CopyFiles]
ak1acx.sys

[Ak1_Device.NT.Services]
AddService = ak1acx, 0x00000002, Ak1_Service

[Ak1_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\ak1acx.sys

[Ak1_Device.NT.Wdf]
KmdfService = ak1acx, Ak1_WdfSection

[Ak1_WdfSection]
KmdfLibraryVersion = $KMDFVERSION$

; Reference strings are the ACX circuit names.
[Ak1_Device.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Output12%, Ak1_Output12
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_Output12%, Ak1_Output12
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_Output12%, Ak1_Output12
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Output34%, Ak1_Output34
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_Output34%, Ak1_Output34
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_Output34%, Ak1_Output34
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Input12%,  Ak1_Input12
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_Input12%,  Ak1_Input12
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_Input12%,  Ak1_Input12

[Ak1_Output12]
AddReg = Ak1_Output12.AddReg, Ak1_Endpoint.AddReg

[Ak1_Output12.AddReg]
HKR,, FriendlyName,, %Output12Name%

[Ak1_Output34]
AddReg = Ak1_Output34.AddReg, Ak1_Endpoint.AddReg

[Ak1_Output34.AddReg]
HKR,, FriendlyName,, %Output34Name%

[Ak1_Input12]
AddReg = Ak1_Input12.AddReg, Ak1_Endpoint.AddReg

[Ak1_Input12.AddReg]
HKR,, FriendlyName,, %Input12Name%

[Ak1_Endpoint.AddReg]
HKR,, CLSID,, %Proxy.CLSID%
HKR, EP\0, %PKEY_AudioEndpoint_Association%,, %KSNODETYPE_ANY%
HKR, EP\0, %PKEY_AudioEndpoint_Supports_EventDriven_Mode%, 0x00010001, 0x1

[Strings]
ProviderName = "ak1-driver"
DiskName     = "Audio Kontrol 1 driver installation disk"
DeviceDesc   = "Audio Kontrol 1"
ServiceDesc  = "Audio Kontrol 1 audio driver"
Output12Name = "Audio Kontrol 1 Outputs 1/2"
Output34Name = "Audio Kontrol 1 Outputs 3/4"
Input12Name  = "Audio Kontrol 1 Inputs 1/2"

KSNAME_Output12 = "Output12"
KSNAME_Output34 = "Output34"
KSNAME_Input12  = "Input12"

Proxy.CLSID          = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO     = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER    = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE   = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME  = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSNODETYPE_ANY       = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association                = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode  = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
